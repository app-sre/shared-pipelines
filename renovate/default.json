{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    "group:allDigest"
  ],
  "updateNotScheduled": true,
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update uv required-version in pyproject.toml",
      "fileMatch": ["pyproject.toml"],
      "matchStrings": ["\\[tool\\.uv\\]\\srequired-version = \">=(?<currentValue>[\\d.]+)\""],
      "depNameTemplate": "ghcr.io/astral-sh/uv",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update uv version in .tool-versions",
      "fileMatch": ["(^|/)\\.tool-versions$"],
      "matchStrings": ["(?:^|\\r\\n|\\r|\\n)uv (?<currentValue>[\\d.]+)"],
      "depNameTemplate": "ghcr.io/astral-sh/uv",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track shared-pipelines pipelineRef revision",
      "managerFilePatterns": ["/^\\.tekton/.*\\.ya?ml$/"],
      "matchStrings": [
        "github\\.com/app-sre/shared-pipelines(?:\\.git)?[\\s\\S]{0,200}?name: revision\\s+value: (?<currentDigest>[0-9a-f]{40})",
        "github\\.com/app-sre/shared-pipelines(?:\\.git)?[\\s\\S]{0,200}?name: revision\\s+value: (?<currentValue>main)"
      ],
      "depNameTemplate": "https://github.com/app-sre/shared-pipelines",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main",
      "autoReplaceStringTemplate": "github.com/app-sre/shared-pipelines\n    - name: revision\n      value: {{{newDigest}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Red Hat Versioning docker images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "quay.io/redhat-services-prod/app-sre-tenant/er-*/**"
      ],
      "versioning": "redhat"
    },
    {
      "description": "No minimumReleaseAge for Red Hat images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "quay.io/redhat-services-prod/app-sre-tenant/**",
        "registry.access.redhat.com/**",
        "registry.redhat.io/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "groupName": "all non-major {{manager}} dependencies",
      "groupSlug": "all-minor-patch-{{manager}}",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "Automerge updates to uv",
      "matchPackageNames": ["ghcr.io/astral-sh/uv"],
      "datasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "uv",
      "groupSlug": "uv",
      "automerge": true
    },
    {
      "description": "Automerge updates to Ubi images",
      "matchPackageNames": [
        "registry.access.redhat.com/ubi*{/,}**"
      ],
      "datasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge updates to ruff",
      "matchPackageNames": ["ruff"],
      "datasources": ["pypi"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Disable automatic updates for Python major/minor versions",
      "matchDatasources": ["python-version"],
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchPackageNames": ["hashicorp/terraform", "terraform"],
      "enabled": false
    },
    {
      "description": "Shared-pipelines pin: disabled outside the rollout scope",
      "matchDepNames": ["https://github.com/app-sre/shared-pipelines"],
      "excludeRepositories": ["app-sre/gabi", "app-sre/python-project-template", "rhur-pixel/gabi"],
      "enabled": false
    },
    {
      "description": "Shared-pipelines pin (rollout scope): no automerge by default",
      "matchDepNames": ["https://github.com/app-sre/shared-pipelines"],
      "matchRepositories": ["app-sre/gabi", "app-sre/python-project-template", "rhur-pixel/gabi"],
      "pinDigests": true,
      "groupName": "shared-pipelines-pin",
      "groupSlug": "shared-pipelines-pin",
      "automerge": false
    }
  ],
  "pin": {
    "automerge": true
  },
  "pinDigest": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
